import { NextResponse } from "next/server";

const DATAFORSEO_ENDPOINT =
  "https://api.dataforseo.com/v3/keywords_data/google_ads/keywords_for_keywords/live";

type DataForSeoTask = {
  result?: Array<{
    items?: Array<{
      keyword?: string;
      search_volume?: number | null;
      competition?: number | null;
      competition_index?: number | null;
      low_top_of_page_bid?: number | null;
      high_top_of_page_bid?: number | null;
    }>;
  }>;
};

function getCredentials() {
  const login = process.env.DATAFORSEO_LOGIN;
  const password = process.env.DATAFORSEO_PASSWORD;

  if (!login || !password) {
    throw new Error("DataForSEO credentials are not configured.");
  }

  return { login, password };
}

function getBasicAuth(login: string, password: string) {
  return Buffer.from(`${login}:${password}`).toString("base64");
}

function getIntent(keyword: string): string {
  const value = keyword.toLowerCase();

  if (
    /\b(buy|price|pricing|cost|service|agency|software|tool|tools)\b/.test(
      value,
    )
  ) {
    return "Commercial";
  }

  if (
    /\b(how|what|why|when|where|guide|tutorial|meaning|definition)\b/.test(
      value,
    )
  ) {
    return "Informational";
  }

  if (
    /\b(login|signin|sign in|official|website|download)\b/.test(value)
  ) {
    return "Navigational";
  }

  return "Informational";
}

function calculateKeywordDifficulty(
  competitionIndex: number | null | undefined,
): number | null {
  if (
    typeof competitionIndex !== "number" ||
    Number.isNaN(competitionIndex)
  ) {
    return null;
  }

  return Math.max(0, Math.min(100, Math.round(competitionIndex)));
}

export async function POST(request: Request) {
  try {
    const body = await request.json();

    const keyword =
      typeof body.keyword === "string" ? body.keyword.trim() : "";

    const location =
      typeof body.location === "string" && body.location.trim()
        ? body.location.trim()
        : "India";

    const languageCode =
      typeof body.languageCode === "string" && body.languageCode.trim()
        ? body.languageCode.trim()
        : "en";

    if (!keyword) {
      return NextResponse.json(
        { error: "Keyword is required." },
        { status: 400 },
      );
    }

    if (keyword.length > 80) {
      return NextResponse.json(
        { error: "Keyword must be 80 characters or less." },
        { status: 400 },
      );
    }

    const { login, password } = getCredentials();

    const response = await fetch(DATAFORSEO_ENDPOINT, {
      method: "POST",
      headers: {
        Authorization: `Basic ${getBasicAuth(login, password)}`,
        "Content-Type": "application/json",
      },
      body: JSON.stringify([
        {
          location_name: location,
          language_code: languageCode,
          keywords: [keyword],
        },
      ]),
      cache: "no-store",
    });

    if (!response.ok) {
      const errorText = await response.text();

      return NextResponse.json(
        {
          error: "DataForSEO request failed.",
          status: response.status,
          details: errorText.slice(0, 500),
        },
        { status: 502 },
      );
    }

    const data = (await response.json()) as DataForSeoTask;

    const item = data.result?.[0]?.items?.[0];

    if (!item) {
      return NextResponse.json(
        {
          error: "No keyword data was returned.",
          data,
        },
        { status: 404 },
      );
    }

    return NextResponse.json({
      keyword: item.keyword || keyword,
      searchVolume: item.search_volume ?? null,
      competition: item.competition ?? null,
      keywordDifficulty: calculateKeywordDifficulty(
        item.competition_index,
      ),
      cpcLow: item.low_top_of_page_bid ?? null,
      cpcHigh: item.high_top_of_page_bid ?? null,
      intent: getIntent(item.keyword || keyword),
      location,
      languageCode,
    });
  } catch (error) {
    console.error("Keyword research error:", error);

    return NextResponse.json(
      {
        error:
          error instanceof Error
            ? error.message
            : "Unexpected keyword research error.",
      },
      { status: 500 },
    );
  }
}